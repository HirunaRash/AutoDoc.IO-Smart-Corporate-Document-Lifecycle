# ─── Copy this file to .env and fill in your values ─────────────────────────

# App
APP_NAME=AutoDoc.IO
DEBUG=false
SECRET_KEY=your-super-secret-key-change-this

# PostgreSQL (auto-set by docker-compose, override for external DB)
DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/autodoc

# ─── AI Provider ─────────────────────────────────────────────────────────────
# Choose: "openai" or "huggingface"
AI_PROVIDER=openai

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini

# HuggingFace (https://huggingface.co/settings/tokens)
HUGGINGFACE_API_KEY=hf_...
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_SUMMARIZE_MODEL=facebook/bart-large-cnn

# ─── Pinecone ─────────────────────────────────────────────────────────────────
# Get from: https://app.pinecone.io
PINECONE_API_KEY=pcsk_...
PINECONE_INDEX_NAME=autodoc-index
PINECONE_ENVIRONMENT=us-east-1

# ─── AWS S3 ───────────────────────────────────────────────────────────────────
# For real AWS S3: leave S3_ENDPOINT_URL empty
# For Supabase Storage: set S3_ENDPOINT_URL=https://<project>.supabase.co/storage/v1/s3
S3_BUCKET_NAME=autodoc-documents
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
S3_ENDPOINT_URL=

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8000
